# ---- Environment
NODE_ENV=development


# ---- Server
PORT=3000
# Number of reverse proxies in front of the app (Render = 1). 0 locally.
TRUST_PROXY=0


# ---- Database (local SQLite file; use libsql://... + DATABASE_AUTH_TOKEN for Turso)
DATABASE_URL=file:./data/wallet.db
DATABASE_AUTH_TOKEN=
# Seed demo user/wallet on startup when the database is empty
AUTO_SEED=true


# ---- Auth
# DEVELOPMENT-ONLY secret. Production uses a separate secret set in the host's env vars.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef0123456789abcdef
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800
MAX_FAILED_LOGINS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SEC=900
# Refresh calls per IP per 15 minutes
REFRESH_RATE_LIMIT_MAX=30


# ---- Setup jet-logger
JET_LOGGER_MODE=console
JET_LOGGER_FILEPATH=jet-logger.log
JET_LOGGER_SHOW_TIME=true
JET_LOGGER_FORMAT=line
