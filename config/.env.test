# ---- Environment
NODE_ENV=test


# ---- Server
PORT=4000
TRUST_PROXY=0


# ---- Database (separate file, wiped by the test setup)
DATABASE_URL=file:./data/test.db
DATABASE_AUTH_TOKEN=
AUTO_SEED=false


# ---- Auth (test-only secret)
JWT_SECRET=test-only-secret-0123456789abcdef0123456789abcdef0123
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800
MAX_FAILED_LOGINS=5
LOGIN_LOCK_MINUTES=15
# High limit so the per-IP limiter doesn't interfere with lockout tests
LOGIN_RATE_LIMIT_MAX=1000
LOGIN_RATE_LIMIT_WINDOW_SEC=900
REFRESH_RATE_LIMIT_MAX=1000


# ---- Setup `jet-logger`
JET_LOGGER_MODE=console
JET_LOGGER_FILEPATH=jet-logger.log
JET_LOGGER_SHOW_TIME=true
JET_LOGGER_FORMAT=line
