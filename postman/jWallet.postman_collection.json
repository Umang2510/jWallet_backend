              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('meta/body envelope', () => {",
                  "  const r = pm.response.json();",
                  "  pm.expect(r.meta.statusCode).to.eql(200);",
                  "  pm.expect(r).to.have.property('body');",
                  "});",
                  "const b = pm.response.json().body;",
                  "if (b && b.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', b.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', b.refreshToken);",
