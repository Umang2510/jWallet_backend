              "mode": "raw",
              "raw": "{\n  \"beneficiaryName\": \"{{beneficiaryName}}\",\n  \"mobileNumber\": \"{{mobileNumber}}\",\n  \"amount\": 1500,\n  \"remarks\": \"Payment for services\",\n  \"challengeId\": \"{{challengeId}}\",\n  \"approval\": {\n    \"method\": \"PIN\",\n    \"pin\": \"{{pin}}\"\n  }\n}",
              "options": {
