        {
          "name": "Change PIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('meta/body envelope', () => {",
                  "  const r = pm.response.json();",
                  "  pm.expect(r.meta.statusCode).to.eql(200);",
                  "  pm.expect(r).to.have.property('body');",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const oldPin = pm.collectionVariables.get('pin');",
                  "  pm.collectionVariables.set('pin', pm.collectionVariables.get('newPin'));",
                  "  pm.collectionVariables.set('newPin', oldPin);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPin\": \"{{pin}}\",\n  \"newPin\": \"{{newPin}}\"\n}",
              "options": {
                "raw": {
